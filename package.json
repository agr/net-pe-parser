{
  "name": "net-pe-reader",
  "version": "0.1.1",
  "description": ".NET PE file reader",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dotnet",
    "pe",
    "parser",
    "reader",
    "metadata",
    "cli-header",
    "typescript",
    "esm"
  ],
  "author": "Andrei Grigorev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agr/net-pe-parser.git"
  },
  "bugs": {
    "url": "https://github.com/agr/net-pe-parser/issues"
  },
  "homepage": "https://github.com/agr/net-pe-parser#readme",
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pe-library": "^2.0.1"
  },
  "files": [
    "./dist/src",
    "README.md",
    "LICENSE"
  ],
  "type": "module"
}
